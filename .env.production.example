# Backend production environment variables
# Production is set up to run the backend on Render and the frontend on Vercel,
# with the database and image storage on Supabase. Set these in the Render dashboard;
# frontend variables are listed in DEPLOYMENT_CHECKLIST.md.
# IMPORTANT: Never commit real values to version control!

# ============================================
# General
# ============================================
NODE_ENV=production
PORT=4000

# ============================================
# Database (Supabase PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# ============================================
# Redis (optional - without it no email/SMS/WhatsApp/PDF jobs run)
# ============================================
# REDIS_URL=redis://default:<password>@<host>:6379

# ============================================
# JWT Authentication
# Generate with: openssl rand -base64 48
# The server refuses to start if this is missing, under 32 characters, or a placeholder.
# ============================================
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ============================================
# URLs
# ============================================
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================
# Supabase Storage (product images)
# ============================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=images

# ============================================
# MTN Mobile Money
# Production always calls the real MTN API (MOMO_SIMULATE is refused), so
# without these credentials MoMo payments fail and only COD works.
# ============================================
MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MOMO_ENVIRONMENT=mtnghana
MOMO_SUBSCRIPTION_KEY=<from-mtn-momo-portal>
MOMO_API_USER=<from-mtn-momo-portal>
MOMO_API_KEY=<from-mtn-momo-portal>
MOMO_CALLBACK_URL=https://api.yourdomain.com/api/payments/webhook

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM_NAME=Your Store
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# SMS / WhatsApp (providers default to a mock that only logs)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_production_account_sid
TWILIO_AUTH_TOKEN=your_production_auth_token
TWILIO_PHONE_NUMBER=+233XXXXXXXXX
WHATSAPP_ENABLED=false

# ============================================
# Google sign-in (the ID token's audience must be one of these)
# ============================================
GOOGLE_CLIENT_ID=<web-or-server-oauth-client-id>
GOOGLE_WEB_CLIENT_ID=<web-oauth-client-id>
# GOOGLE_EXTRA_CLIENT_IDS=<android-client-id>,<ios-client-id>

# ============================================
# Orders
# ============================================
# Unpaid Mobile Money orders are cancelled (stock released) after this many hours
UNPAID_ORDER_TTL_HOURS=24

# ============================================
# Store
# ============================================
DEFAULT_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵
COMPANY_NAME=Your Store
COMPANY_ADDRESS=Your Address, Accra
COMPANY_PHONE=+233XXXXXXXXX
COMPANY_EMAIL=contact@yourdomain.com

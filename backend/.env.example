# ===========================================
# Backend API Environment Variables
# Copy to .env and fill in your own values. Never commit .env.
# ===========================================

# Server
NODE_ENV=development
PORT=4000

# Database: local PostgreSQL (see README). For a hosted database such as
# Supabase, use its pooled URL here and its direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# Redis (optional - enables email/SMS/WhatsApp/PDF background jobs)
# REDIS_URL=redis://localhost:6379

# JWT Authentication - generate your own: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS (multiple origins separated by comma)
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend URL (for links in emails: password reset, verification)
FRONTEND_URL=http://localhost:3000

# ===========================================
# Image storage (optional)
# Without Supabase, uploads are saved to public/uploads on this machine.
# ===========================================
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<your-service-role-key>
# SUPABASE_STORAGE_BUCKET=images

# ===========================================
# Google sign-in (optional)
# ===========================================
# GOOGLE_CLIENT_ID=<your-oauth-client-id>
# GOOGLE_WEB_CLIENT_ID=<your-web-oauth-client-id>
# GOOGLE_EXTRA_CLIENT_IDS=<android-client-id>,<ios-client-id>

# ===========================================
# Email (SMTP, optional - emails are skipped when unset)
# ===========================================
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-password>
# SMTP_FROM_NAME=E-Commerce Store
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# SMS / WhatsApp (mock providers only log messages)
# ===========================================
SMS_PROVIDER=mock
# twilio:         TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
# africastalking: AT_API_KEY, AT_USERNAME, AT_SENDER_ID
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock

# ===========================================
# MTN Mobile Money
# ===========================================
# Outside production, MoMo is simulated (every payment succeeds) unless
# MOMO_SIMULATE=false. Production always calls MTN and needs these:
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MOMO_ENVIRONMENT=sandbox
# MOMO_SUBSCRIPTION_KEY=<from-mtn-momo-portal>
# MOMO_API_USER=<from-mtn-momo-portal>
# MOMO_API_KEY=<from-mtn-momo-portal>
# MOMO_CALLBACK_URL=https://<your-api-domain>/api/payments/webhook

# ===========================================
# Store
# ===========================================
DEFAULT_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵
MAX_FILE_SIZE=5242880
# Unpaid Mobile Money orders are cancelled (stock released) after this many hours
UNPAID_ORDER_TTL_HOURS=24

# Company info (for invoices/receipts)
COMPANY_NAME=E-Commerce Store
COMPANY_ADDRESS=Accra, Ghana
COMPANY_PHONE=+233 30 000 0000

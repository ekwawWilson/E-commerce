# ===========================================
# E-Commerce Application Environment Variables
# ===========================================
# Copy this file to .env and update with your values

# ============================================
# General
# ============================================
NODE_ENV=development

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}

# ============================================
# JWT Authentication
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# API Configuration
# ============================================
BACKEND_PORT=4000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# ============================================
# URLs
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Cloudinary (Image Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Email (SMTP)
# For development, uses Mailpit (no auth needed)
# ============================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.local

# ============================================
# Twilio (SMS/WhatsApp) - Optional
# ============================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================
# Payment (Paystack)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# ============================================
# Admin Notifications
# ============================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_WHATSAPP=+1234567890

# ============================================
# Development Tools Ports (optional)
# ============================================
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Backend API base URL, inlined into the app bundle at build time.
# On a physical device or emulator use your computer's LAN IP (or a deployed
# URL), not localhost. Copy this file to .env and restart `expo start`.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:4000/api

# Google sign-in: your OAuth web client ID (must also be in the backend's
# GOOGLE_WEB_CLIENT_ID). Also set iosUrlScheme in app.json for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
